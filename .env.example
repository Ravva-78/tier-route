# TierRoute Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit .env or paste your live API keys into public repositories.

# Groq API Key (get a free key at https://console.groq.com)
GROQ_API_KEY=

# Operation mode: "mock" (offline simulation) or "live" (calls real models)
TIERROUTE_MODE=live

# Optional: Custom Ollama / Edge Model Base URL (e.g., http://localhost:11434/v1 or Colab/Kaggle tunnel URL)
TIERROUTE_LOCAL_BASE_URL=http://localhost:11434/v1
